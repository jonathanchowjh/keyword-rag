# Copy to .env and fill in. compose.yaml reads it; nothing in it is committed.

# Optional. Becomes the Anthropic connection on the Settings page, applied at
# every start and read-only there. Any provider can instead be added on the
# Settings page with no .env at all. A key from the Console
# organisation linked to your Max plan's API credit, made in a workspace with
# its own spend limit. Never the claude.ai login.
# With no AI model set up, free methods work and spending endpoints 503.
ANTHROPIC_API_KEY=

# This service's own monthly ceiling, in USD, counted from its own calls.
# Read-only on the Settings page when set here.
RAGQA_MONTHLY_CAP_USD=20

# The default job model: <connection>/<model id>, or a bare model id that one
# enabled model has. A value naming no stored model is taken as an Anthropic
# model id and added, at $0, to the Anthropic connection; price it on the
# Settings page. claude-sonnet-5-5 is about 20x the price.
# Read-only on the Settings page while set. Leave it unset to choose the model on the
# Settings page; with only ANTHROPIC_API_KEY set, the default starts as claude-haiku-5-5.
# RAGQA_MODEL=claude-haiku-5-5

# HTTP basic auth over every route. Set both or neither.
# RAGQA_USERNAME=
# RAGQA_PASSWORD=

# Local models (fastembed / ONNX). Each store keeps the dense model it was made with;
# Settings -> Search defaults can name another for new stores.
# RAGQA_DENSE_MODEL=BAAI/bge-small-en-v1.5  (the model new stores take; Qwen/Qwen3-Embedding-0.6B-Q is more accurate and slower)
# RAGQA_JUDGE_MODEL=BAAI/bge-small-en-v1.5
# BAAI/bge-reranker-v2-m3-int8 suits a faster machine.
# RAGQA_RERANK_MODEL=jinaai/jina-reranker-v1-tiny-en

# Hugging Face read token, only needed to load GPQA, which is gated: accept its
# terms at https://huggingface.co/datasets/Idavidrein/gpqa first.
# HF_TOKEN=

# The Hub repo of published builds a load applies with no AI call; empty turns it off.
# RAGQA_BUILD_HUB=jonathanmiro97/keyword-rag-builds

# Set by compose.yaml; unset means Qdrant runs embedded in the API process, under RAGQA_HOME/qdrant,
# fine for a small store.
# RAGQA_QDRANT_URL=http://qdrant:6333
