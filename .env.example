# Copy to .env and fill in. compose.yaml reads it; nothing in it is committed.

# A key from the Console organisation linked to your Max plan's API credit,
# made in a workspace with its own spend limit. Never the claude.ai login.
# Leave empty to run retrieval only: free methods work, spending endpoints 503.
ANTHROPIC_API_KEY=

# This service's own monthly ceiling, in USD, counted from its own calls.
RAGQA_MONTHLY_CAP_USD=20

# Default Claude model. claude-sonnet-5-5 is about 20x the price.
RAGQA_MODEL=claude-haiku-5-5

# HTTP basic auth over every route. Set both or neither.
# RAGQA_USERNAME=
# RAGQA_PASSWORD=

# Local models (fastembed / ONNX). Changing the dense model after a collection
# is built makes that collection refuse new items until it is rebuilt.
# RAGQA_DENSE_MODEL=Qwen/Qwen3-Embedding-0.6B-Q
# RAGQA_JUDGE_MODEL=BAAI/bge-small-en-v1.5
# RAGQA_RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8

# Hugging Face read token, only needed to load GPQA, which is gated: accept its
# terms at https://huggingface.co/datasets/Idavidrein/gpqa first.
# HF_TOKEN=

# Set by compose.yaml; unset means Qdrant runs in-process (tests only).
# RAGQA_QDRANT_URL=http://qdrant:6333
